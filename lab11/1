while True:
    r = input("Você quer saber como manter uma pessoa ingênua ocupada por horas? S/N ")

    if r in ("s", "S", "sim", "SIM"):
        continue

    if r in ("n", "N", "não", "NÃO"):
        print("Obrigada. Tenha um bom dia!")
        break

    print(f'"{r}" não é uma resposta válida de sim/não.')
