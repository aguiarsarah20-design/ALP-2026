# Lê um valor do usuário sem conversão
valor = input("Digite um valor: ")

# Converte para inteiro
valor_int = int(valor)

# Converte para decimal
valor_float = float(valor)

# Converte para booleano
valor_bool = bool(valor)

print(valor_int)
print(valor_float)
print(valor_bool)

